{
  "name": "@omicronenergy/oscd-menu-import-ied",
  "version": "0.0.0",
  "description": "OpenSCD menu plugin for importing an IED from an SCL file.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-menu-import-ied.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-menu-import-ied/issues"
  },
  "homepage": "https://github.com/OMICRONEnergyOSS/oscd-menu-import-ied",
  "keywords": ["OpenSCD", "iec61850"],
  "contributors": ["OMICRON Electronics GmbH"],
  "exports": {
    ".": "./dist/oscd-menu-import-ied.js",
    "./oscd-menu-import-ied.js": "./dist/oscd-menu-import-ied.js"
  },
  "files": [
    "/dist/",
    "!/dist/demo/",
    "!/dist/**/*.spec.*",
    "!/dist/**/*.test.*"
  ],
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "build": "oscd build",
    "bundle": "oscd bundle",
